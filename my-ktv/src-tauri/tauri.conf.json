{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-ktv",
  "version": "0.1.0",
  "identifier": "com.a0970.my-ktv",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "my-ktv",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/downloads/**"
        ]
      },
      "csp": "default-src 'self'; media-src 'self' asset: http://tauri.localhost https://tauri.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "downloader"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
